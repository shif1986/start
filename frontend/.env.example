# Variables publiques du client Supabase. Ne jamais utiliser de clé service_role ici.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_DATA_SOURCE=supabase

# URL HTTPS recevant les messages du formulaire de contact.
# Compatible avec une fonction serveur ou un service de formulaires acceptant du JSON.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/votre-identifiant
