# Variables publiques du client Supabase. Ne jamais utiliser de clé service_role ici.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLISHABLE
VITE_DATA_SOURCE=supabase

# Facultatif : endpoint HTTPS personnalisé recevant les messages au format JSON.
# Sans cette variable, le formulaire utilise FormSubmit et envoie les messages à
# contact@startreseauchretien.com.
VITE_CONTACT_ENDPOINT=

# URL HTTPS recevant les signalements de contenus au format JSON.
VITE_REPORT_ENDPOINT=https://formspree.io/f/votre-identifiant-signalement
