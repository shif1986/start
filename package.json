{
  "name": "start-marketplace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test:run",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "backend:start": "npx supabase start --workdir backend",
    "backend:stop": "npx supabase stop --workdir backend",
    "backend:reset": "npx supabase db reset --workdir backend",
    "backend:test": "npx supabase test db --workdir backend",
    "backend:types": "npx supabase gen types typescript --local --workdir backend > frontend/src/lib/supabase/database.types.ts",
    "check:netlify": "node scripts/check-netlify-routes.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "ops:health": "bash scripts/check-operational-health.sh",
    "backup:verify": "bash scripts/verify-supabase-backup.sh"
  },
  "devDependencies": {
    "supabase": "^2.113.0"
  }
}
